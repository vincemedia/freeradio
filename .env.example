# Free Radio has no secrets yet. This file documents every variable the app
# may read, so nothing is read that is not listed here.

# Absolute origin used for permalinks and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Cloudflare RealtimeKit ----
# The API token, with Realtime edit permission. Server-side only: it can create
# meetings and read every recording on the account, so it is never exposed to
# the browser. The browser only ever receives a per-participant token, minted
# per person per meeting.
CLOUDFLARE=
# The account the RealtimeKit app belongs to. Cloudflare dashboard sidebar, or
# the segment after /accounts/ in its URL.
CLOUDFLARE_ACCOUNT_ID=
# Printed by `bun run realtime:bootstrap`, which also creates the presets.
REALTIMEKIT_APP_ID=

# ---- Avatars (Vercel Blob) ----
# Server-side only. Uploads are re-encoded before they are stored, so nothing
# the browser claims about a file is trusted.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Optional. Protects /api/cron/sweep when it is called from outside Vercel.
CRON_SECRET=
